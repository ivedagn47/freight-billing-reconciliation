{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "adjudication-results",
  "description": "Output of adjudicate_findings: one adjudication_output-shaped result per finding requiring adjudication. No monetary field appears here or in any item -- adjudication_gate enforces this independently of the per-item schema each result was already validated against during generation.",
  "type": "object",
  "required": ["adjudications", "summary"],
  "additionalProperties": false,
  "properties": {
    "adjudications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "disposition", "justification", "governing_clauses", "memo_narrative"],
        "additionalProperties": false,
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "disposition": { "type": "string", "enum": ["accept", "dispute", "escalate"] },
          "justification": { "type": "string", "minLength": 1 },
          "governing_clauses": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "memo_narrative": {
            "type": "object",
            "required": ["what_happened", "why", "recommended_action"],
            "additionalProperties": false,
            "properties": {
              "what_happened": { "type": "string", "minLength": 1 },
              "why": { "type": "string", "minLength": 1 },
              "recommended_action": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["adjudicated_count", "by_disposition"],
      "additionalProperties": false,
      "properties": {
        "adjudicated_count": { "type": "integer", "minimum": 0 },
        "by_disposition": {
          "type": "object",
          "required": ["accept", "dispute", "escalate"],
          "additionalProperties": false,
          "properties": {
            "accept": { "type": "integer", "minimum": 0 },
            "dispute": { "type": "integer", "minimum": 0 },
            "escalate": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
