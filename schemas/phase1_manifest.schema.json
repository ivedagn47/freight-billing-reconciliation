{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phase1-manifest",
  "description": "Output of discover_invoices: every file under data/invoices/, classified.",
  "type": "object",
  "required": ["target_period", "files"],
  "additionalProperties": false,
  "properties": {
    "target_period": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "carrier", "doc_type", "invoice_id", "period", "period_ambiguous", "in_scope", "reason"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "carrier": { "type": ["string", "null"] },
          "doc_type": { "type": ["string", "null"] },
          "invoice_id": { "type": ["string", "null"] },
          "period": { "type": ["string", "null"] },
          "period_ambiguous": { "type": "boolean" },
          "in_scope": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
