{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phase1-parsed-invoices",
  "description": "Output of parse_invoices: normalized invoice headers and every canonical line parsed from in-scope invoices. Only reachable with zero residue -- the node raises before returning if any line/block failed to parse.",
  "type": "object",
  "required": ["invoices", "lines"],
  "additionalProperties": false,
  "properties": {
    "invoices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["invoice", "carrier", "file", "declared_line_count", "declared_total", "declared_discount"],
        "additionalProperties": false,
        "properties": {
          "invoice": { "type": "string", "minLength": 1 },
          "carrier": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "declared_line_count": { "type": ["number", "null"] },
          "declared_total": { "type": ["number", "null"] },
          "declared_discount": { "type": ["number", "null"] }
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["invoice", "carrier", "consignment_ref", "billed_amount", "billed_components", "stated_attributes", "provenance", "raw"],
        "additionalProperties": false,
        "properties": {
          "invoice": { "type": "string", "minLength": 1 },
          "carrier": { "type": "string", "minLength": 1 },
          "consignment_ref": { "type": "string", "minLength": 1 },
          "billed_amount": { "type": "number" },
          "billed_components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "amount"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "amount": { "type": "number" }
              }
            }
          },
          "stated_attributes": { "type": "object" },
          "provenance": {
            "type": "object",
            "required": ["file", "locator"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "locator": { "type": "string", "minLength": 1 }
            }
          },
          "raw": { "type": "object" }
        }
      }
    }
  }
}
